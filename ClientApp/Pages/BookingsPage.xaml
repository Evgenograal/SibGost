<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClientApp.Pages.BookingsPage">
    
    <Grid RowDefinitions="Auto, *">
        <Frame Grid.Row="0" BackgroundColor="White" Margin="0,0,0,10" CornerRadius="0" Padding="20" HasShadow="False">
            <Label Text="Мои бронирования" FontSize="24" FontAttributes="Bold" TextColor="#1E88E5"/>
        </Frame>

        <CollectionView x:Name="BookingsCollection" Grid.Row="1" Margin="15,0">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="30">
                    <Label Text="📭" FontSize="48" HorizontalOptions="Center"/>
                    <Label Text="У вас пока нет бронирований" TextColor="Gray" HorizontalOptions="Center" Margin="0,10"/>
                    <Button Text="🔍 Найти номер" Clicked="SearchClicked" 
                            BackgroundColor="Transparent" TextColor="#1E88E5" FontAttributes="Bold"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,0,0,15" Padding="0" CornerRadius="12" HasShadow="True" BackgroundColor="White" BorderColor="#E0E0E0">
                        <VerticalStackLayout>

                            <VerticalStackLayout Padding="15" Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding Room.RoomNumber, StringFormat='Номер {0}'}" 
                                               FontSize="18" FontAttributes="Bold" TextColor="#333"/>
                                        <Label Text="{Binding Room.Category.Name}" 
                                               TextColor="#1E88E5" FontSize="13"/>
                                    </VerticalStackLayout>

                                    <Label Grid.Column="1" Text="{Binding Status}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" Padding="6,4" BackgroundColor="#F5F5F5" TextColor="#666">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Подтверждено">
                                                <Setter Property="BackgroundColor" Value="#E8F5E9"/>
                                                <Setter Property="TextColor" Value="#2E7D32"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Отменено">
                                                <Setter Property="BackgroundColor" Value="#FFEBEE"/>
                                                <Setter Property="TextColor" Value="#C62828"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Завершено">
                                                <Setter Property="BackgroundColor" Value="#E3F2FD"/>
                                                <Setter Property="TextColor" Value="#1565C0"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>

                                <HorizontalStackLayout Spacing="5" Margin="0,5,0,0">
                                    <Label Text="📅" FontSize="14"/>
                                    <Label Text="{Binding CheckIn, StringFormat='{0:dd.MM.yyyy}'}" TextColor="#555"/>
                                    <Label Text="→" TextColor="#999"/>
                                    <Label Text="{Binding CheckOut, StringFormat='{0:dd.MM.yyyy}'}" TextColor="#555"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            
                            <Button Text="❌ Отменить бронь" Clicked="Cancel" CommandParameter="{Binding .}" 
                                    BackgroundColor="#FFF3E0" TextColor="#E65100" HeightRequest="45" CornerRadius="0" 
                                    BorderColor="#FFE0B2" BorderWidth="1"
                                    IsVisible="{Binding IsCancellable}"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>