<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClientApp.Pages.ChangePasswordPage"
             Title="ChangePasswordPage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="🔐 Смена пароля" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   Margin="0,20"/>

            <!-- Текущий пароль -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Текущий пароль:" FontAttributes="Bold"/>
                <Entry x:Name="EntryCurrentPass" 
                       IsPassword="True" 
                       Placeholder="Введите текущий пароль" 
                       BackgroundColor="#f5f5f5"/>
            </VerticalStackLayout>

            <!-- Новый пароль -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Новый пароль:" FontAttributes="Bold"/>
                <Entry x:Name="EntryNewPass" 
                       IsPassword="True" 
                       Placeholder="Мин. 12 символов, A-Z, a-z, 0-9, @$!%*?" 
                       BackgroundColor="#f5f5f5" />
            </VerticalStackLayout>

            <!-- Подтверждение -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Подтвердите новый пароль:" FontAttributes="Bold"/>
                <Entry x:Name="EntryConfirmPass" 
                       IsPassword="True" 
                       Placeholder="Повторите новый пароль" 
                       BackgroundColor="#f5f5f5"/>
            </VerticalStackLayout>

            <!-- Ошибка -->
            <Label x:Name="LblError" 
                   TextColor="Red" 
                   IsVisible="False" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center"/>

            <!-- Кнопки -->
            <VerticalStackLayout Spacing="10" Margin="0,30">
                <Button Text="💾 Сохранить" 
                        Clicked="OnSaveClicked" 
                        BackgroundColor="#007ACC" 
                        TextColor="White" 
                        HeightRequest="50"/>
                <Button Text="❌ Отмена" 
                        Clicked="OnCancelClicked" 
                        BackgroundColor="#6c757d" 
                        TextColor="White" 
                        HeightRequest="50"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>