<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClientApp.Pages.RoomsPage"
             BackgroundColor="#F8F9FA">

    <Grid RowDefinitions="Auto, *">
        <Frame Grid.Row="0" BackgroundColor="White" Margin="0,0,0,10" CornerRadius="0" Padding="20">
            <Label Text="Выберите номер" FontSize="24" FontAttributes="Bold" TextColor="#1E88E5"/>
        </Frame>

        <CollectionView x:Name="RoomsCollection" Grid.Row="1" Margin="15,0">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="30">
                    <Label Text="📭" FontSize="48" HorizontalOptions="Center"/>
                    <Label Text="Номера временно отсутствуют" TextColor="Gray" HorizontalOptions="Center" Margin="0,10"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,0,0,15" Padding="0" CornerRadius="12" HasShadow="True" BackgroundColor="White" BorderColor="#E0E0E0">
                        <VerticalStackLayout>

                            <Frame Padding="0" CornerRadius="12" Margin="0" IsClippedToBounds="True" HeightRequest="180">
                                <Image Source="{Binding ImgUrl}" Aspect="AspectFill"/>
                            </Frame>

                            <VerticalStackLayout Padding="15" Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding RoomNumber, StringFormat='Номер {0}'}" 
                                               FontSize="20" FontAttributes="Bold" TextColor="#333"/>
                                        <Label Text="{Binding Category.Name}" 
                                               TextColor="#1E88E5" FontSize="14" FontAttributes="Bold"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding Status}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Свободен">
                                                <Setter Property="TextColor" Value="#43A047"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Занят">
                                                <Setter Property="TextColor" Value="#E53935"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Ремонт">
                                                <Setter Property="TextColor" Value="#FB8C00"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>

                                <Label Text="{Binding Category.Description}" 
                                       TextColor="#666" FontSize="13" MaxLines="2" LineBreakMode="TailTruncation"/>

                                <Label Text="{Binding Category.DisplayPrice}" 
                                       FontSize="18" FontAttributes="Bold" TextColor="#43A047" Margin="0,5,0,0"/>
                            </VerticalStackLayout>

                            <Button Text="📅 Забронировать" Clicked="BookClicked" CommandParameter="{Binding .}" 
                                    BackgroundColor="#1E88E5" TextColor="White" HeightRequest="50" CornerRadius="0" 
                                    Margin="0" IsEnabled="{Binding IsActive}" FontSize="16"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>