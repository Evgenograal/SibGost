<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClientApp.Pages.LoginPage">
    <VerticalStackLayout Padding="40" VerticalOptions="Center">
        
        <Label Text="Авторизация" FontSize="24" HorizontalOptions="Center" Margin="20"/>

        <Entry x:Name="EntryLogin" Placeholder="Логин" Margin="0,10"/>
        <Entry x:Name="EntryPassword" Placeholder="Пароль" IsPassword="True" Margin="0,10"/>

        <Button Text="Войти" Clicked="OnLoginClicked" Margin="0,20" Background="Aquamarine" TextColor="Black"/>

        <Label x:Name="LblError" TextColor="Red" HorizontalOptions="Center" IsVisible="False"/>

        <Button Text="Нет аккаунта? Зарегистрироваться" Clicked="OnRegisterClicked" BackgroundColor="Transparent" TextColor="Aquamarine" Margin="0,10"/>
    </VerticalStackLayout>
</ContentPage>