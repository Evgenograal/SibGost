<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StaffApp.Pages.ManagePricePoliciesPage"
             Title="Политики цен">

    <Grid RowDefinitions="Auto,*,Auto">
        <Label x:Name="LblCategoryTitle" 
               Text="Категория: ..." 
               FontSize="20" 
               FontAttributes="Bold" 
               TextColor="#1E88E5" 
               Padding="15,10,15,15"/>

        <CollectionView x:Name="PoliciesCollection" Grid.Row="1" Margin="15,0,15,15">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="20">
                    <Label Text="📉" FontSize="48" HorizontalOptions="Center"/>
                    <Label Text="Политик цен нет" TextColor="Gray" HorizontalOptions="Center" Margin="0,10"/>
                    <Label Text="Добавьте первую политику" TextColor="Gray" FontSize="12" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,8" Padding="20" BorderColor="#ddd" HasShadow="True" CornerRadius="10">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                            <Grid ColumnDefinitions="Auto,*,Auto,*" Grid.Row="0" ColumnSpacing="10">
                                <Label Text="📅" TextColor="#757575" Grid.Column="0" VerticalOptions="Center"/>
                                <Label Text="{Binding StartDate, StringFormat='{0:dd.MM.yyyy}'}" 
                                       FontSize="15" 
                                       FontAttributes="Bold"
                                       TextColor="#424242" 
                                       Grid.Column="1"
                                       VerticalOptions="Center"/>
                                <Label Text="→" TextColor="#757575" Grid.Column="2" VerticalOptions="Center"/>
                                <Label Text="{Binding EndDate, StringFormat='{0:dd.MM.yyyy}'}" 
                                       FontSize="15" 
                                       FontAttributes="Bold"
                                       TextColor="#424242" 
                                       Grid.Column="3"
                                       VerticalOptions="Center"/>
                            </Grid>

                            <Label Text="{Binding Multiplier, StringFormat='Множитель: x{0}'}" 
                                   FontSize="18"
                                   FontAttributes="Bold" 
                                   TextColor="#FB8C00" 
                                   Grid.Row="1" 
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Margin="0,10,0,5"/>

                            <Label Text="{Binding Description}" 
                                   TextColor="#757575" 
                                   Grid.Row="2" 
                                   Grid.Column="0" 
                                   Grid.ColumnSpan="2"
                                   Margin="0,0,0,8"/>

                            <HorizontalStackLayout Grid.Row="3" Grid.Column="0" Spacing="8">
                                <Label Text="{Binding IsActive, StringFormat='Активна: {0}'}" 
                                       TextColor="#43A047"
                                       FontAttributes="Bold"/>
                            </HorizontalStackLayout>

                            <VerticalStackLayout Grid.Row="0" Grid.RowSpan="4" Grid.Column="1" Spacing="8" VerticalOptions="Center" Margin="15,0,0,0">
                                <Button Text="✏️" 
                                        Clicked="Edit" 
                                        CommandParameter="{Binding .}" 
                                        BackgroundColor="#1E88E5"
                                        TextColor="White"
                                        WidthRequest="45"
                                        HeightRequest="45"
                                        CornerRadius="8"
                                        FontSize="18"/>
                                <Button Text="🗑️" 
                                        Clicked="Delete" 
                                        CommandParameter="{Binding .}" 
                                        BackgroundColor="#E53935"
                                        TextColor="White"
                                        WidthRequest="45"
                                        HeightRequest="45"
                                        CornerRadius="8"
                                        FontSize="18"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Frame Grid.Row="2" 
               Padding="20" 
               Margin="15" 
               BorderColor="#FB8C00" 
               HasShadow="True"
               CornerRadius="12"
               HeightRequest="400">
            <ScrollView>
            <VerticalStackLayout Spacing="15">
                <Label Text="➕ Добавить/Изменить политику" 
                       FontSize="18" 
                       FontAttributes="Bold" 
                       TextColor="#FB8C00"/>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Дата начала" FontSize="14" TextColor="#757575"/>
                    <DatePicker x:Name="PickerStartDate" 
                                Format="dd.MM.yyyy" 
                                BackgroundColor="#f5f5f5"
                                HeightRequest="45" TextColor="Black"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Дата окончания" FontSize="14" TextColor="#757575"/>
                    <DatePicker x:Name="PickerEndDate" 
                                Format="dd.MM.yyyy" 
                                BackgroundColor="#f5f5f5"
                                HeightRequest="45" TextColor="Black"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Множитель цены" FontSize="14" TextColor="#757575"/>
                    <Entry x:Name="EntryMultiplier" 
                           Placeholder="Например: 1.5 (увеличение на 50%)" 
                           Keyboard="Numeric" 
                           BackgroundColor="#f5f5f5"
                           HeightRequest="45" TextColor="Black"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Описание" FontSize="14" TextColor="#757575"/>
                    <Editor x:Name="EditorDescription" 
                            Placeholder="Например: Новогодние праздники, Летний сезон" 
                            HeightRequest="80" 
                            BackgroundColor="#f5f5f5" TextColor="Black"/>
                </VerticalStackLayout>

                <HorizontalStackLayout Spacing="10" Margin="0,5">
                    <CheckBox x:Name="CheckIsActive" 
                              IsChecked="True" 
                              Color="#43A047"
                              Scale="1.2"/>
                    <Label Text="Активная политика" 
                           VerticalOptions="Center"
                           FontSize="16"
                           TextColor="#424242"/>
                </HorizontalStackLayout>

                <Button Text="💾 Сохранить политику" 
                        Clicked="Save" 
                        BackgroundColor="#43A047"
                        TextColor="White"
                        HeightRequest="50"
                        CornerRadius="10"
                        FontSize="16"
                        FontAttributes="Bold"/>
                </VerticalStackLayout>
            </ScrollView>
        </Frame>
    </Grid>
</ContentPage>