<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StaffApp.Pages.ManageAmenitiesPage"
             Title="Удобства в номерах">

    <Grid RowDefinitions="*,Auto">
        <CollectionView x:Name="AmenitiesCollection" Margin="15">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="Список удобств пуст" 
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           Margin="0,10"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5" Padding="15" BorderColor="#ddd" HasShadow="True">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Text="{Binding Name}" 
                                   FontSize="18" 
                                   FontAttributes="Bold"
                                   Grid.Row="0" Grid.Column="0"
                                   TextColor="Black"/>

                            <Label Text="{Binding Description}" 
                                   TextColor="Gray"
                                   Grid.Row="1" Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Margin="0,5,0,0"/>

                            <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="10">
                                <Button Text="✏️" 
                                        Clicked="OnEditClicked" 
                                        CommandParameter="{Binding .}" 
                                        BackgroundColor="#1E88E5"
                                        TextColor="White"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        CornerRadius="8"/>

                                <Button Text="🗑️" 
                                        Clicked="OnDeleteClicked" 
                                        CommandParameter="{Binding .}" 
                                        BackgroundColor="#E53935"
                                        TextColor="White"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        CornerRadius="8"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Frame x:Name="FrameAddForm" 
               Grid.Row="1" 
               Padding="15" 
               Margin="10" 
               BorderColor="#1E88E5" 
               HasShadow="True">
            <VerticalStackLayout Spacing="10">
                <Label Text="➕ Добавить/Изменить удобство" FontSize="16" FontAttributes="Bold" TextColor="#1E88E5"/>
                <Entry x:Name="EntryName" Placeholder="Название" BackgroundColor="#f5f5f5" TextColor="Black"/>
                <Editor x:Name="EditorDescription" Placeholder="Описание (необязательно)" HeightRequest="60" BackgroundColor="#f5f5f5" TextColor="Black"/>
                <Button Text="💾 Сохранить" Clicked="OnSaveClicked" BackgroundColor="#43A047" TextColor="White" HeightRequest="45" CornerRadius="8"/>
            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentPage>