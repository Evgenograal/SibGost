<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StaffApp.Pages.StaffDashboardPage"
             x:Name="DashboardPage"
             BackgroundColor="#F8F9FA">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <Frame Background="#1E88E5" 
                   HasShadow="True" 
                   Padding="0" 
                   Margin="0,10,0,24"
                   CornerRadius="20"
                   BorderColor="Transparent">
                <Frame.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1E88E5" Offset="0.0"/>
                        <GradientStop Color="#1565C0" Offset="1.0"/>
                    </LinearGradientBrush>
                </Frame.Background>

                <Grid Padding="24,20" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                    <Frame x:Name="ActivityIndicator"
                            Grid.Row="0" Grid.RowSpan="2" 
                            WidthRequest="56" HeightRequest="56"
                            CornerRadius="28"
                            BackgroundColor="#10B981"
                            HasShadow="True"
                            Margin="0,0,16,0"
                            Padding="0"
                            IsClippedToBounds="True">
                        <Label Text="👤" 
                               FontSize="24"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Frame>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="SibGost Hotel" 
                               FontSize="24" 
                               FontAttributes="Bold"
                               TextColor="White"/>
                        <Label x:Name="LblUserName" 
                               Text="Панель управления" 
                               FontSize="14"
                               TextColor="#E3F2FD"
                               Margin="0,2,0,0"/>
                        <Label x:Name="LblActivityStatus"
                               Text="● Активен"
                               FontSize="12"
                               TextColor="#10B981"
                               Margin="0,4,0,0"/>
                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <Label Text="📈 Статистика" 
                   FontSize="20" 
                   FontAttributes="Bold"
                   TextColor="#1F2937"
                   Margin="0,0,0,12"/>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">

                <Frame BackgroundColor="White" 
                       Padding="20" 
                       CornerRadius="16"
                       HasShadow="True"
                       BorderColor="#E5E7EB"
                       Grid.Row="0" Grid.Column="0">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🛏️ Всего номеров" 
                               TextColor="#6B7280" 
                               FontSize="13"/>
                        <Label x:Name="LblTotalRooms" 
                               Text="0" 
                               FontSize="28" 
                               FontAttributes="Bold" 
                               TextColor="#1E40AF"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame BackgroundColor="White" 
                       Padding="20" 
                       CornerRadius="16"
                       HasShadow="True"
                       BorderColor="#E5E7EB"
                       Grid.Row="0" Grid.Column="1">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="📋 Активных броней" 
                               TextColor="#6B7280" 
                               FontSize="13"/>
                        <Label x:Name="LblActiveBookings" 
                               Text="0" 
                               FontSize="28" 
                               FontAttributes="Bold" 
                               TextColor="#EA580C"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame BackgroundColor="White" 
                       Padding="20" 
                       CornerRadius="16"
                       HasShadow="True"
                       BorderColor="#E5E7EB"
                       Grid.Row="1" Grid.Column="0">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="✈️ Сегодня заездов" 
                               TextColor="#6B7280" 
                               FontSize="13"/>
                        <Label x:Name="LblTodayCheckIns" 
                               Text="0" 
                               FontSize="28" 
                               FontAttributes="Bold" 
                               TextColor="#059669"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame BackgroundColor="White" 
                       Padding="20" 
                       CornerRadius="16"
                       HasShadow="True"
                       BorderColor="#E5E7EB"
                       Grid.Row="1" Grid.Column="1">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🚪 Сегодня выездов" 
                               TextColor="#6B7280" 
                               FontSize="13"/>
                        <Label x:Name="LblTodayCheckOuts" 
                               Text="0" 
                               FontSize="28" 
                               FontAttributes="Bold" 
                               TextColor="#DC2626"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>
            
            <Label Text="⚙️ Управление" 
                   FontSize="20" 
                   FontAttributes="Bold"
                   TextColor="#1F2937"
                   Margin="0,24,0,12"/>

            <VerticalStackLayout Spacing="12">

                <Frame BackgroundColor="White" 
                       Padding="0" 
                       CornerRadius="16"
                       HasShadow="True"
                       BorderColor="#E5E7EB">
                    <Button Text="🛏️ Управление номерами" 
                            Clicked="OnManageRoomsClicked"
                            BackgroundColor="Transparent"
                            TextColor="#1F2937"
                            HeightRequest="64"
                            FontSize="16"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            HorizontalOptions="Fill"/>
                </Frame>

                <Frame BackgroundColor="White" 
                       Padding="0" 
                       CornerRadius="16"
                       HasShadow="True"
                       BorderColor="#E5E7EB">
                    <Button Text="📅 Бронирования" 
                            Clicked="OnManageBookingsClicked"
                            BackgroundColor="Transparent"
                            TextColor="#1F2937"
                            HeightRequest="64"
                            FontSize="16"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            HorizontalOptions="Fill"/>
                </Frame>

                <Frame BackgroundColor="White" 
                       Padding="0" 
                       CornerRadius="16"
                       HasShadow="True"
                       BorderColor="#E5E7EB">
                    <Button Text="👥 Пользователи" 
                            Clicked="OnManageUsersClicked"
                            BackgroundColor="Transparent"
                            TextColor="#1F2937"
                            HeightRequest="64"
                            FontSize="16"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            HorizontalOptions="Fill"/>
                </Frame>

                <Frame x:Name="FrameAmenities"
                       BackgroundColor="White" 
                       Padding="0" 
                       CornerRadius="16"
                       HasShadow="True"
                       BorderColor="#E5E7EB"
                       IsVisible="False">
                    <Button Text="✨ Управление удобствами" 
                            Clicked="OnManageAmenitiesClicked" 
                            BackgroundColor="Transparent"
                            TextColor="#1F2937"
                            HeightRequest="64"
                            FontSize="16"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            HorizontalOptions="Fill"/>
                </Frame>

                <Frame x:Name="FrameCategories"
                       BackgroundColor="White" 
                       Padding="0" 
                       CornerRadius="16"
                       HasShadow="True"
                       BorderColor="#E5E7EB"
                       IsVisible="False">
                    <Button Text="🏷️ Категории и цены" 
                            Clicked="OnManageCategoriesClicked" 
                            BackgroundColor="Transparent"
                            TextColor="#1F2937"
                            HeightRequest="64"
                            FontSize="16"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            HorizontalOptions="Fill"/>
                </Frame>

            </VerticalStackLayout>

            <Button Text="🚪 Выйти из системы" 
                    Clicked="OnLogoutClicked"
                    BackgroundColor="#FEE2E2"
                    TextColor="#DC2626"
                    HeightRequest="56"
                    FontSize="15"
                    FontAttributes="Bold"
                    CornerRadius="14"
                    Margin="0,24,0,12"
                    BorderColor="#FCA5A5"
                    BorderWidth="1"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>