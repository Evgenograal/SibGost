<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StaffApp.Pages.ManageUsersPage"
             x:Name="UsersPage"
             Title="Пользователи">
    <Grid RowDefinitions="*,Auto">
        <CollectionView x:Name="UsersCollection" Margin="15">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="20">
                    <Label Text="👥" FontSize="48" HorizontalOptions="Center"/>
                    <Label Text="Пользователей нет" TextColor="Gray" HorizontalOptions="Center" Margin="0,10"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,8" Padding="20" BorderColor="#ddd" HasShadow="True" CornerRadius="10">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                            <Label Text="{Binding FirstName}" 
                                   FontSize="18" 
                                   FontAttributes="Bold"
                                   TextColor="#424242"
                                   Grid.Row="0" Grid.Column="0"/>

                            <Label Text="{Binding LastName}" 
                                   FontSize="16"
                                   TextColor="#757575"
                                   Grid.Row="0" Grid.Column="0"
                                   Margin="120,0,0,0"/>

                            <Label Text="{Binding Login, StringFormat=' {0}'}" 
                                   TextColor="#1E88E5"
                                   Grid.Row="1" Grid.Column="0"
                                   Margin="0,5,0,0"/>

                            <Label Text="{Binding Email, StringFormat='📧 {0}'}" 
                                   TextColor="#757575"
                                   Grid.Row="2" Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Margin="0,5,0,0"/>

                            <Frame Grid.Row="3" Grid.Column="0" 
                                   Padding="10,5" 
                                   CornerRadius="8"
                                   BackgroundColor="#E3F2FD"
                                   HasShadow="False"
                                   Margin="0,10,0,0">
                                <Label Text="{Binding Role.Name, StringFormat='👤 {0}'}" 
                                       TextColor="#1E88E5"
                                       FontAttributes="Bold"/>
                            </Frame>

                            <VerticalStackLayout Grid.Row="0" Grid.RowSpan="4" Grid.Column="1" Spacing="8" VerticalOptions="Start" Margin="15,0,0,0">
                                <Button Text="✏️" 
                                Clicked="Edit" 
                                CommandParameter="{Binding .}" 
                                BackgroundColor="#1E88E5" 
                                TextColor="White"
                                WidthRequest="45" 
                                HeightRequest="45" 
                                CornerRadius="8" 
                                FontSize="18"
                                IsVisible="{Binding IsAdmin, Source={x:Reference UsersPage}}"/>

                                <Button Text="🗑️" 
                                Clicked="Delete" 
                                CommandParameter="{Binding .}" 
                                BackgroundColor="#E53935" 
                                TextColor="White"
                                WidthRequest="45" 
                                HeightRequest="45" 
                                CornerRadius="8" 
                                FontSize="18"
                                IsVisible="{Binding IsAdmin, Source={x:Reference UsersPage}}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="1" Margin="15,10,15,15" Spacing="10">
            <Button x:Name="BtnToggleForm" 
                    Text="➕ Добавить пользователя" 
                    Clicked="ToggleFormClick"
                    BackgroundColor="#1E88E5"
                    TextColor="White"
                    HeightRequest="50"
                    CornerRadius="10"
                    FontAttributes="Bold"/>

            <Frame x:Name="FormFrame" 
                   IsVisible="False"
                   Padding="20" 
                   BorderColor="#1E88E5" 
                   HasShadow="True"
                   CornerRadius="12">
                <ScrollView>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="➕ Добавить/Изменить пользователя" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="#1E88E5"/>

                        <Entry x:Name="EntryLogin" Placeholder="Логин" BackgroundColor="#f5f5f5" HeightRequest="45" TextColor="Black"/>
                        <Entry x:Name="EntryPassword" Placeholder="Пароль (пусто = не менять)" IsPassword="True" BackgroundColor="#f5f5f5" HeightRequest="45" TextColor="Black"/>
                        <Entry x:Name="EntryFirstName" Placeholder="Имя" BackgroundColor="#f5f5f5" HeightRequest="45" TextColor="Black"/>
                        <Entry x:Name="EntryLastName" Placeholder="Фамилия (необязательно)" BackgroundColor="#f5f5f5" HeightRequest="45" TextColor="Black"/>
                        <Entry x:Name="EntryEmail" Placeholder="Email" Keyboard="Email" BackgroundColor="#f5f5f5" HeightRequest="45" TextColor="Black"/>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Роль" FontSize="14" TextColor="#757575"/>
                            <Picker x:Name="PickerRole" BackgroundColor="#f5f5f5" HeightRequest="45" TextColor="Black"/>
                        </VerticalStackLayout>

                        <Button Text="💾 Сохранить" Clicked="Save" BackgroundColor="#43A047" TextColor="White" HeightRequest="50" CornerRadius="10" FontAttributes="Bold"/>
                        <Button x:Name="BtnCancel" Text="❌ Отмена" Clicked="Cancel" BackgroundColor="#757575" TextColor="White" HeightRequest="45" CornerRadius="8" IsVisible="False"/>
                    </VerticalStackLayout>
                </ScrollView>
            </Frame>
        </VerticalStackLayout>
    </Grid>
</ContentPage>